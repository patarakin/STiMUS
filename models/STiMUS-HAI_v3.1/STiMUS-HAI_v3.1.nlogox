<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="false">
  <code><![CDATA[
;; ============================================================
;; STiMUS — Stigmergy and Mutualism in Socio-Technical Systems
;; NetLogo 7 — version 3.1
;; Human/AI collaborative editing with judgment-vs-prediction
;; task typing and an AI-trust mechanic (Manseau-inspired extension)
;; ============================================================

globals [
  total-edits             ; cumulative count of all edit events
  cross-author-edits      ; cumulative count of edits where the previous editor differed
  ESR                     ; event-level Edit Succession Ratio = cross-author-edits / total-edits
  mean-quality            ; mean patch quality
  mean-resource-value     ; mean patch resource-value
  mutualism-index         ; (mean agent benefit-gain + mean-resource-value) / 2
  coediting-density       ; density of the co-editing network
  active-pages-share      ; share of patches with at least one edit
  edge-log                ; bipartite edit log: (tick, who, pageid, specialty, topic-tag, quality, breed-tag, task-type)
  initial-task-count      ; number of patches flagged is-task? at setup
  tasks-completed         ; running count of completed tasks
  edits-on-tasks-count    ; running count of edits on active (is-task?) patches
  explicit-attempts-count ; times a contributor entered the p-explicit branch
  explicit-edits-count    ; times explicit mode actually selected and edited a visible task
  explicit-fallback-count ; times explicit mode found no visible task and fell back to stigmergy
  agents                  ; turtle-set (humans + ai-agents)
  human-edits-count       ; cumulative count of edits performed by humans
  ai-edits-count          ; cumulative count of edits performed by ai-agents
  hh-cross-author-edits   ; cumulative count of human edits whose previous editor was a different human
  ai-pheromone-deposits   ; cumulative count of pheromone-deposit events made by ai-agents
  judgment-edits-count    ; cumulative count of edits landing on task-type = "judgment" patches
  prediction-edits-count  ; cumulative count of edits landing on task-type = "prediction" patches
]

breed [humans human]
breed [ai-agents ai-agent]
undirected-link-breed [coedits coedit]

patches-own [
  pheromone          ; stigmergic trace intensity; diffuses and evaporates
  quality            ; content quality in [0,1]
  completeness       ; task/content completion in [0,1]
  recentness         ; ticks since last edit
  last-editor-id     ; who of the most recent editor, or -1
  last-editor-ai?    ; was the most recent editor an ai-agent?
  ever-ai-touched?   ; has any ai-agent ever edited this patch (sticky true)
  edit-count         ; total edits received
  edit-authors        ; list of unique authors
  is-task?           ; is this patch a designated task?
  task-complexity    ; complexity in [0,1]
  resource-value     ; mutualistic benefit available to visitors in [0,1]
  reuse-count        ; number of reuse/edit events
  maintenance-need   ; degradation accumulator in [0,1]
  topic-tag          ; domain index in [0, topic-count-1]
  task-type          ; "prediction" or "judgment"
  judgment-weight    ; in [0,1]; 0 for "prediction" patches, >0 for "judgment" patches
]

turtles-own [
  skill                   ; competence in [0.3,1.0]
  motivation              ; engagement in [0.05,1.0]; updated over time for humans, constant for ai-agents
  shared-mental-model     ; proxy for team shared understanding in [0,1]; ai-agents always 0
  specialty               ; preferred topic index in [0, topic-count-1]
  my-last-page            ; last edited patch or nobody
  my-edit-count           ; contributor's total edits
  benefit-gain            ; cumulative benefit obtained from artefacts
  explicit-mode?          ; did the current step use explicit task assignment?
  is-ai?                  ; true for ai-agents, false for humans
  ai-trust                ; in [0,1]; meaningful for humans only. ai-agents hold a neutral placeholder
  ai-consecutive-success  ; counter of consecutive good AI observations by a human
  ai-error-counter        ; diagnostic counter of observed-AI-error events by a human
]

;; ------------------------------------------------------------
;; fixed internal parameters
;; ------------------------------------------------------------

to-report alpha-pheromone
  report 1.6
end

to-report beta-heuristic
  report 1.3
end

to-report specialization-weight
  report 0.60
end

to-report topic-match-bonus
  report 0.50
end

to-report explicit-effect
  report 0.10
end

to-report ai-motivation-constant
  report 1.0
end

to-report judgment-weight-min
  report 0.4
end

to-report judgment-weight-max
  report 1.0
end

; Scales down an ai-agent's edit-power on a "judgment" patch by up to
; this fraction, proportional to that patch's judgment-weight.
to-report judgment-penalty-strength
  report 1.0
end

; ai-trust value assigned to every human at setup: an agnostic prior.
to-report ai-trust-initial
  report 0.5
end

; Neutral placeholder value given to ai-agents' own ai-trust slot; never
; read anywhere in the model.
to-report ai-trust-neutral-value
  report 1.0
end

; Returns true if quality-value ranks at or below the
; ai-trust-error-percentile-th percentile of current quality across all
; edited patches (edit-count > 0). Percentile rank is scale-free: it is
; unaffected by how compressed or saturated the population's quality
; distribution is.
to-report quality-is-low-relative-to-population? [quality-value]
  let touched-patches patches with [edit-count > 0]
  if not any? touched-patches [ report false ]
  let quality-values sort [quality] of touched-patches
  let n length quality-values
  let rank length filter [q -> q <= quality-value] quality-values
  let percentile-rank (rank / n) * 100
  report percentile-rank <= ai-trust-error-percentile
end

; Percentile cutoff below which an AI-touched patch's pre-edit-quality
; counts as a "low-quality" / erroneous contribution (bottom quartile).
to-report ai-trust-error-percentile
  report 25
end

; Amount ai-trust drops on a single observed AI error.
to-report ai-trust-penalty
  report 0.40
end

; Amount ai-trust rises once ai-consecutive-success reaches
; ai-trust-recovery-threshold.
to-report ai-trust-recovery
  report 0.15
end

; Number of consecutive good AI observations a human needs before
; ai-trust-recovery is applied.
to-report ai-trust-recovery-threshold
  report 3
end

to-report quality-gain-factor
  report 0.08
end

to-report completeness-gain-factor
  report 0.05
end

to-report maintenance-relief-factor
  report 0.08
end

to-report maintenance-drift
  report 0.010
end

to-report resource-decay
  report 0.003
end

to-report motivation-recovery
  report 0.03
end

to-report motivation-fatigue
  report 0.005
end

to-report resource-benefit-weight
  report 0.40
end

to-report quality-benefit-weight
  report 0.20
end

to-report topic-benefit-weight
  report 0.30
end

to-report task-completion-threshold
  report 0.90
end

to-report task-priority-bonus
  report 1.25
end

;; ------------------------------------------------------------
;; diagnostic reporters
;; ------------------------------------------------------------

to-report bigraph-edges
  report length remove-duplicates
    map [[e1] -> (list (item 1 e1) (item 2 e1))] edge-log
end

to-report active-pages
  report count patches with [edit-count > 0]
end

to-report active-authors
  report count agents with [my-edit-count > 0]
end

to-report non-task-active-pages
  report count patches with [not is-task? and edit-count > 0]
end

; Patch-level Edit Succession Ratio (distinct from the event-level global ESR).
to-report esr-value
  let edited patches with [edit-count > 0]
  if not any? edited [ report 0 ]
  report (count edited with [length remove-duplicates edit-authors > 1]) /
         count edited
end

to-report mutualism-idx
  report mutualism-index
end

; Normalised Shannon entropy of the edit-count distribution across edited patches.
to-report page-diversity
  let edited patches with [edit-count > 0]
  let k count edited
  if total-edits = 0 or k <= 1 [ report 0 ]
  let h 0
  ask edited [
    let p edit-count / total-edits
    set h h - (p * ln p)
  ]
  report h / ln k
end

; Gini coefficient of my-edit-count across all agents (participation inequality).
to-report gini-edits
  if not any? agents [ report 0 ]
  let xs sort [my-edit-count] of agents
  let n length xs
  if n = 0 [ report 0 ]
  let total sum xs
  if total = 0 [ report 0 ]
  let weighted-sum 0
  let i 1
  foreach xs [ x ->
    set weighted-sum weighted-sum + (i * x)
    set i i + 1
  ]
  report ((2 * weighted-sum) / (n * total)) - ((n + 1) / n)
end

to-report mean-motivation
  if not any? agents [ report 0 ]
  report mean [motivation] of agents
end

to-report human-only-motivation
  if not any? humans [ report 0 ]
  report mean [motivation] of humans
end

to-report benefit-gain-per-edit
  let active agents with [my-edit-count > 0]
  if not any? active [ report 0 ]
  report mean [benefit-gain / my-edit-count] of active
end

to-report mutualism-index-norm
  report (benefit-gain-per-edit + mean [resource-value] of patches) / 2
end

to-report edits-on-tasks
  report edits-on-tasks-count
end

to-report edits-on-non-tasks
  report total-edits - edits-on-tasks-count
end

to-report task-edit-share
  if total-edits = 0 [ report 0 ]
  report edits-on-tasks-count / total-edits
end

; Pearson correlation between resource-value and edit-count across patches.
to-report resource-edit-correlation
  let edited patches with [edit-count > 0]
  if count edited < 2 [ report 0 ]

  let pairs [ (list resource-value edit-count) ] of edited
  let rvs map [pair -> item 0 pair] pairs
  let ecs map [pair -> item 1 pair] pairs

  let mr mean rvs
  let me mean ecs

  let ss-r sum (map [pair -> (((item 0 pair) - mr) ^ 2)] pairs)
  let ss-e sum (map [pair -> (((item 1 pair) - me) ^ 2)] pairs)

  if (ss-r = 0) or (ss-e = 0) [ report 0 ]

  let num sum (map [pair -> (((item 0 pair) - mr) * ((item 1 pair) - me))] pairs)
  let den sqrt (ss-r * ss-e)

  report num / den
end

to-report explicit-edit-share
  if total-edits = 0 [ report 0 ]
  report explicit-edits-count / total-edits
end

to-report explicit-hit-rate
  if explicit-attempts-count = 0 [ report 0 ]
  report explicit-edits-count / explicit-attempts-count
end

to-report explicit-fallback-rate
  if explicit-attempts-count = 0 [ report 0 ]
  report explicit-fallback-count / explicit-attempts-count
end

to-report active-task-count
  report count patches with [is-task?]
end

to-report edge-log-csv
  let header "tick,author_id,pageid,specialty,topic_tag,quality,breed_tag,task_type\n"
  let rows map [[e1] ->
    (word (item 0 e1) "," (item 1 e1) "," (item 2 e1) ","
          (item 3 e1) "," (item 4 e1) "," (precision (item 5 e1) 4) ","
          (item 6 e1) "," (item 7 e1))
  ] edge-log

  if empty? rows [ report header ]

  report (word header (reduce [[a b] -> (word a "\n" b)] rows))
end

;; ------------------------------------------------------------
;; setup
;; ------------------------------------------------------------

to setup
  clear-all
  set total-edits 0
  set cross-author-edits 0
  set ESR 0
  set mean-quality 0
  set mean-resource-value 0
  set mutualism-index 0
  set coediting-density 0
  set active-pages-share 0
  set edge-log []
  set initial-task-count 0
  set tasks-completed 0
  set edits-on-tasks-count 0
  set explicit-attempts-count 0
  set explicit-edits-count 0
  set explicit-fallback-count 0
  set human-edits-count 0
  set ai-edits-count 0
  set hh-cross-author-edits 0
  set ai-pheromone-deposits 0
  set judgment-edits-count 0
  set prediction-edits-count 0
  setup-patches
  setup-agents
  set agents (turtle-set humans ai-agents)
  reset-ticks
end

to setup-patches
  ask patches [
    set pheromone 0
    set quality random-float 0.15
    set completeness random-float 0.20
    set recentness 9999
    set last-editor-id -1
    set last-editor-ai? false
    set ever-ai-touched? false
    set edit-count 0
    set edit-authors []
    set is-task? false
    set task-complexity random-float 1
    set resource-value 0.2 + random-float 0.2
    set reuse-count 0
    set maintenance-need random-float 0.3
    set topic-tag random topic-count
    recolor-patch
  ]

  ask n-of num-tasks patches [
    set is-task? true
    set task-complexity 0.4 + random-float 0.6
    set pcolor orange
  ]
  set initial-task-count count patches with [is-task?]

  ; flag a judgment-share fraction of all patches as task-type = "judgment"
  ; with a random judgment-weight; the rest are "prediction" / 0
  ask patches [
    set task-type "prediction"
    set judgment-weight 0
  ]
  ask n-of round (judgment-share * count patches) patches [
    set task-type "judgment"
    set judgment-weight judgment-weight-min + random-float (judgment-weight-max - judgment-weight-min)
  ]
end

; Create num-contributors agents, split into humans and ai-agents by ai-share.
to setup-agents
  let n-ai-agents round (num-contributors * ai-share)
  let n-humans num-contributors - n-ai-agents

  create-humans n-humans [
    setxy random-xcor random-ycor
    set shape "person"
    set size 1.2
    set color green
    set skill 0.3 + random-float 0.7
    set motivation 0.4 + random-float 0.6
    set shared-mental-model 0.1 + random-float 0.1
    set specialty random topic-count
    set my-last-page nobody
    set my-edit-count 0
    set benefit-gain 0
    set explicit-mode? false
    set is-ai? false
    set ai-trust ai-trust-initial
    set ai-consecutive-success 0
    set ai-error-counter 0
  ]

  create-ai-agents n-ai-agents [
    setxy random-xcor random-ycor
    set shape "circle"
    set size 1.2
    set color cyan
    set skill 0.3 + random-float 0.7
    set motivation ai-motivation-constant
    set shared-mental-model 0
    set specialty random topic-count
    set my-last-page nobody
    set my-edit-count 0
    set benefit-gain 0
    set explicit-mode? false
    set is-ai? true
    set ai-trust ai-trust-neutral-value
    set ai-consecutive-success 0
    set ai-error-counter 0
  ]
end

;; ------------------------------------------------------------
;; main loop
;; ------------------------------------------------------------

to go
  if not any? agents [ stop ]

  ask agents [
    ifelse activity-probability >= 1 [
      step-contributor
    ] [
      if random-float 1 < activity-probability [
        step-contributor
      ]
    ]
  ]

  diffuse pheromone diffusion-rate

  ask patches [
    set pheromone pheromone * (1 - evaporation-rate)
    if pheromone < 0 [ set pheromone 0 ]
    set recentness recentness + 1
    set maintenance-need min (list 1 (maintenance-need + maintenance-drift))
    set resource-value max (list 0 (resource-value - resource-decay * maintenance-need))
    recolor-patch
  ]

  update-metrics
  tick
end

to step-contributor
  let target choose-target-page
  if target != nobody [
    move-to target
    perform-edit target
  ]
end

;; ------------------------------------------------------------
;; choice logic
;; ------------------------------------------------------------

; Choose a target patch: with probability p-explicit, look for a visible
; assigned task; otherwise (or on fallback) use the stigmergic ACO rule.
to-report choose-target-page
  let visible patches in-radius vision-radius
  if not any? visible [ report nobody ]

  ifelse random-float 1 < p-explicit [
    set explicit-attempts-count explicit-attempts-count + 1
    let task-candidates visible with [is-task?]
    ifelse any? task-candidates [
      set explicit-mode? true
      set-mode-color "explicit"
      report max-one-of task-candidates [task-complexity + (1 - completeness)]
    ] [
      set explicit-fallback-count explicit-fallback-count + 1
      set explicit-mode? false
      set-mode-color "stigmergic"
      report aco-choose-patch visible
    ]
  ] [
    set explicit-mode? false
    set-mode-color "stigmergic"
    report aco-choose-patch visible
  ]

end

; Recolour the calling turtle to reflect mode and breed.
to set-mode-color [mode]
  ifelse is-ai? [
    ifelse mode = "explicit" [ set color orange ] [ set color cyan ]
  ] [
    ifelse mode = "explicit" [ set color yellow ] [ set color green ]
  ]
end

; ACO-style stigmergic target choice:
;   (pheromone+0.01)^alpha * (1-completeness+0.01)^beta
;   * (1 + maintenance-need) * task-factor * topic-match-factor
to-report aco-choose-patch [candidate-patches]
  let weighted-patches candidate-patches with [completeness < 1 or maintenance-need > 0.05]
  if not any? weighted-patches [ report one-of candidate-patches ]

  report max-one-of weighted-patches
  [
    (ifelse-value pheromone-enabled? [(pheromone + 0.01) ^ alpha-pheromone] [1.0]) *
    (((1 - completeness) + 0.01) ^ beta-heuristic) *
    (1 + maintenance-need) *
    (ifelse-value is-task? [task-priority-bonus] [1]) *
    (ifelse-value (topic-tag = [specialty] of myself)
      [1 + specialization-weight]
      [1])
  ]
end

;; ------------------------------------------------------------
;; editing
;; ------------------------------------------------------------

; Apply one edit to the target patch and update the editor's state and
; the co-editing network.
to perform-edit [target]
  let previous-editor-id [last-editor-id] of target
  let previous-editor-was-ai? [last-editor-ai?] of target
  let previous-authors [edit-authors] of target
  let target-was-task? [is-task?] of target
  let pre-edit-quality [quality] of target
  let topic-match ifelse-value ([topic-tag] of target = specialty) [1] [0]
  let explicit-bonus ifelse-value explicit-mode? [explicit-effect] [0]

  ; scales down an ai-agent's edit-power on a "judgment" patch, proportional
  ; to that patch's judgment-weight; humans are never penalised
  let judgment-penalty ifelse-value (is-ai? and [task-type] of target = "judgment")
    [1 - ([judgment-weight] of target * judgment-penalty-strength)]
    [1]

  let edit-power skill * (0.5 + 0.5 * motivation) * (1 + topic-match * topic-match-bonus + explicit-bonus) * judgment-penalty

  if explicit-mode? [
    set explicit-edits-count explicit-edits-count + 1
  ]

  ifelse is-ai? [
    set ai-edits-count ai-edits-count + 1
  ] [
    set human-edits-count human-edits-count + 1
  ]

  ifelse [task-type] of target = "judgment" [
    set judgment-edits-count judgment-edits-count + 1
  ] [
    set prediction-edits-count prediction-edits-count + 1
  ]

  ; --- change the artefact (stigmergic + mutualistic layers) ---
  let editor-is-ai? is-ai?
  ask target [
    if pheromone-enabled? [
      set pheromone pheromone + edit-increment
      if editor-is-ai? [ set ai-pheromone-deposits ai-pheromone-deposits + 1 ]
    ]
    set quality min (list 1 (quality + quality-gain-factor * edit-power * (1 - quality)))
    set completeness min (list 1 (completeness + completeness-gain-factor * edit-power * (1 - completeness)))
    set recentness 0
    set edit-count edit-count + 1
    set reuse-count reuse-count + 1
    set resource-value min (list 1 (resource-value + mutualism-gain-factor * edit-power * (1 - resource-value)))
    set maintenance-need max (list 0 (maintenance-need - maintenance-relief-factor * edit-power))
    set edit-authors remove-duplicates lput [who] of myself edit-authors
    set last-editor-id [who] of myself
    set last-editor-ai? editor-is-ai?
    if editor-is-ai? [ set ever-ai-touched? true ]
    if is-task? and completeness >= task-completion-threshold [
      set is-task? false
      set tasks-completed tasks-completed + 1
    ]
  ]

  ; --- shared mental model and co-editing links ---
  ; SMM grows only on human<-human succession; ai-agents never accumulate SMM
  if previous-editor-id >= 0 and previous-editor-id != who [
    set cross-author-edits cross-author-edits + 1
    if not is-ai? and not previous-editor-was-ai? [
      set shared-mental-model min (list 1 (shared-mental-model + lambda-smm))
      set hh-cross-author-edits hh-cross-author-edits + 1
    ]
    let prev-agent turtle previous-editor-id
    if prev-agent != nobody and prev-agent != self [
      if not link-neighbor? prev-agent [
        create-coedit-with prev-agent [
          set color gray
          set thickness 0.1
        ]
      ]
    ]
  ]

  if length previous-authors > 0 [
    let other-authors remove who previous-authors
    foreach other-authors [ a ->
      let other-agent turtle a
      if other-agent != nobody and other-agent != self [
        if not link-neighbor? other-agent [
          create-coedit-with other-agent [
            set color gray
            set thickness 0.1
          ]
        ]
      ]
    ]
  ]

  ; --- ai-trust update ---
  ; fires only when a human edits a patch whose previous editor was an
  ; ai-agent; asymmetric update — trust erodes fast on error, rebuilds
  ; slowly only after a run of consecutive good observations
  if not is-ai? and previous-editor-was-ai? [
    ifelse quality-is-low-relative-to-population? pre-edit-quality [
      set ai-trust max (list 0 (ai-trust - ai-trust-penalty))
      set ai-consecutive-success 0
      set ai-error-counter ai-error-counter + 1
    ] [
      set ai-consecutive-success ai-consecutive-success + 1
      if ai-consecutive-success >= ai-trust-recovery-threshold [
        set ai-trust min (list 1 (ai-trust + ai-trust-recovery))
        set ai-consecutive-success 0
      ]
    ]
  ]

  ; --- benefit and motivation update ---
  ; benefit-gain is tallied for both breeds; the motivation UPDATE
  ; (benefit -> motivation feedback) is applied only to humans
  let local-benefit ([resource-value] of target * resource-benefit-weight) +
                    ([quality] of target * quality-benefit-weight) +
                    (topic-match * topic-benefit-weight)

  ; a human editing a patch previously touched by an ai-agent perceives
  ; only a trust-gated share of the objective local-benefit
  if not is-ai? and previous-editor-was-ai? [
    set local-benefit local-benefit * (0.5 + 0.5 * ai-trust)
  ]

  set benefit-gain benefit-gain + local-benefit
  if not is-ai? [
    set motivation max (list 0.05
                   (min (list 1
                   (motivation + motivation-recovery * local-benefit - motivation-fatigue))))
  ]
  set my-last-page target
  set my-edit-count my-edit-count + 1
  set total-edits total-edits + 1

  let pageid (word [pxcor] of target "_" [pycor] of target)
  let breed-tag ifelse-value is-ai? ["ai"] ["human"]
  let entry (list ticks who pageid specialty [topic-tag] of target [quality] of target breed-tag [task-type] of target)
  set edge-log lput entry edge-log

  if target-was-task? [
    set edits-on-tasks-count edits-on-tasks-count + 1
  ]

end

;; ------------------------------------------------------------
;; metrics
;; ------------------------------------------------------------

to update-metrics
  if total-edits > 0 [
    set ESR cross-author-edits / total-edits
  ]
  set mean-quality mean [quality] of patches
  set mean-resource-value mean [resource-value] of patches
  set mutualism-index (mean [benefit-gain] of agents + mean-resource-value) / 2
  set coediting-density network-density
  set active-pages-share count patches with [edit-count > 0] / count patches
end

to recolor-patch
  if is-task? [
    if completeness >= task-completion-threshold [
      set pcolor green
    ]
    if completeness < task-completion-threshold [
      if maintenance-need > 0.6 [
        set pcolor red + 1
      ]
      if maintenance-need <= 0.6 [
        set pcolor orange
      ]
    ]
  ]

  if not is-task? [
    if edit-count = 0 [
      set pcolor gray + 2
    ]
    if edit-count > 0 and resource-value < 0.4 [
      set pcolor sky
    ]
    if edit-count > 0 and resource-value >= 0.4 and resource-value < 0.7 [
      set pcolor blue
    ]
    if edit-count > 0 and resource-value >= 0.7 [
      set pcolor violet
    ]
  ]
end

to-report network-density
  let n count agents
  if n < 2 [ report 0 ]
  report (2 * count coedits) / (n * (n - 1))
end

; Density of the co-editing network restricted to human-human links only.
to-report hh-coediting-density
  let n count humans
  if n < 2 [ report 0 ]
  let hh-links coedits with [ ([breed] of end1 = humans) and ([breed] of end2 = humans) ]
  report (2 * count hh-links) / (n * (n - 1))
end

to-report task-completion-rate
  if initial-task-count = 0 [ report 0 ]
  report tasks-completed / initial-task-count
end

; Mean shared-mental-model, computed over humans only (ai-agents hold 0).
to-report mean-shared-mental-model
  if not any? humans [ report 0 ]
  report mean [shared-mental-model] of humans
end

to-report human-smm
  report mean-shared-mental-model
end

to-report mean-authors-per-page
  if not any? patches with [edit-count > 0] [ report 0 ]
  report mean [length edit-authors] of patches with [edit-count > 0]
end

to save-edge-log [filename]
  file-open filename
  file-print "tick,author_id,pageid,specialty,topic_tag,quality,breed_tag,task_type"
  foreach edge-log [ e1 ->
    file-print
      (word (item 0 e1) ","
            (item 1 e1) ","
            (item 2 e1) ","
            (item 3 e1) ","
            (item 4 e1) ","
            (precision (item 5 e1) 4) ","
            (item 6 e1) ","
            (item 7 e1))
  ]
  file-close
end

;; ------------------------------------------------------------
;; human / AI breed-split reporters (measurement only)
;; ------------------------------------------------------------

to-report ESR-all
  report ESR
end

; Human-only analogue of ESR: among edits performed by humans, the share
; whose previous editor was also a (different) human.
to-report ESR-HH
  if human-edits-count = 0 [ report 0 ]
  report hh-cross-author-edits / human-edits-count
end

to-report ai-pheromone-share
  if total-edits = 0 [ report 0 ]
  report ai-pheromone-deposits / total-edits
end

to-report human-edit-share
  if total-edits = 0 [ report 0 ]
  report human-edits-count / total-edits
end

to-report ai-edit-share
  if total-edits = 0 [ report 0 ]
  report ai-edits-count / total-edits
end

;; ------------------------------------------------------------
;; AI-trust / task-type reporters (measurement only)
;; ------------------------------------------------------------

to-report mean-ai-trust
  if not any? humans [ report 0 ]
  report mean [ai-trust] of humans
end

to-report judgment-edit-share
  if total-edits = 0 [ report 0 ]
  report judgment-edits-count / total-edits
end

to-report prediction-edit-share
  if total-edits = 0 [ report 0 ]
  report prediction-edits-count / total-edits
end

; Mean SMM of humans whose most recent edit landed on a judgment-type patch.
to-report human-smm-judgment
  let relevant humans with [my-last-page != nobody and [task-type] of my-last-page = "judgment"]
  if not any? relevant [ report 0 ]
  report mean [shared-mental-model] of relevant
end

; Mean SMM of humans whose most recent edit landed on a prediction-type patch.
to-report human-smm-prediction
  let relevant humans with [my-last-page != nobody and [task-type] of my-last-page = "prediction"]
  if not any? relevant [ report 0 ]
  report mean [shared-mental-model] of relevant
end

to-report mean-ai-error-observations
  if not any? humans [ report 0 ]
  report mean [ai-error-counter] of humans
end
]]></code>
