  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="E0_demo" repetitions="10" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>share-active-foragers</metric>
        <metric>share-alive-resources</metric>
        <metric>mean-quality</metric>
        <metric>mean-skill</metric>
        <metric>fail-rate</metric>
        <metric>share-too-easy</metric>
        <metric>unique-links</metric>
        <metric>skill-complexity-gap</metric>
        <metric>renewal-count</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="world-type">
          <value value="&quot;meadow&quot;"></value>
          <value value="&quot;wiki&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="renewal?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="skill-growth">
          <value value="0.02"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="perception-radius">
          <value value="6"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="trait-matching?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="feedback?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="adaptive-foraging?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="trait-development?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-foragers">
          <value value="30"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-resources">
          <value value="98"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="cluster-count">
          <value value="6"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="cluster-spread">
          <value value="3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="activity-mean">
          <value value="0.3"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="activity-concentration">
          <value value="2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="adaptation-rate">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="regeneration-rate">
          <value value="0.2"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mutualism-strength">
          <value value="0.1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="visit-cost">
          <value value="0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="renewal-rate">
          <value value="0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="offspring-sd">
          <value value="0.05"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
    <experiment name="E1_ladder" repetitions="20" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>share-active-foragers</metric>
        <metric>mean-energy</metric>
        <metric>fail-rate</metric>
        <metric>service-rate</metric>
        <metric>mean-gain-per-visit</metric>
        <metric>unique-links</metric>
        <metric>connectance-obs</metric>
        <metric>cross-cluster-share</metric>
        <metric>mean-quality</metric>
        <metric>share-alive-resources</metric>
        <metric>effective-diet</metric>
        <metric>visit-diet</metric>
        <metric>mean-skill</metric>
        <metric>skill-gain</metric>
        <metric>share-in-band</metric>
        <metric>share-too-easy</metric>
        <metric>web-edgelist</metric>
        <metric>forager-traits</metric>
        <metric>resource-traits</metric>
        <metric>forager-skills</metric>
        <metric>renewal-count</metric>
        <metric>share-renewed</metric>
        <metric>mean-complexity</metric>
        <metric>mean-complexity-alive</metric>
        <metric>skill-complexity-gap</metric>
        <metric>renewal-list</metric>
        <metric>visit-sequence</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="world-type">
          <value value="&quot;meadow&quot;"></value>
          <value value="&quot;wiki&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="trait-matching?">
          <value value="false"></value>
