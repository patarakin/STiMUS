<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MUTUS — Mutualism in Texts and Understanding of Students
;; NetLogo 7 — version 1.0 (model ladder M0–M5a)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Specification: MUTUS_ODD_v1.0.md (section numbers in comments, e.g. §7.3).
;; Parent model:  STiMUS v2.1 (stigmergy removed; see ODD Appendix A).
;;
;; One computational core, two worlds ("meadow" / "wiki"), six levels:
;;   M0  heterogeneous activity, neutral partner choice
;;   M1  + trait matching (ZPD band)                  trait-matching?
;;   M2  + mutualistic feedback, resource dynamics    feedback?
;;   M3  + adaptive foraging                          adaptive-foraging?
;;   M4  + trait development (learning)               trait-development?
;;   M5a + renewal of faded resources                 renewal?
;; Any combination of switches is valid. M4 needs M1, M5a needs M2.
;;
;; Clarifications (kept from the development versions):
;;  (C1) feedback? = off is a strict commensal control: resource state is held
;;       constant and reward is restored to reward-max at the end of each tick.
;;  (C2) Foragers start at a random resource (+ small noise).
;;  (C3) prev-resource ("carried pollen") is updated only after successful
;;       visits (eta > 0): a failed visit leaves no pollen and no link.
;;  (C5) World parameters (zpd-below, zpd-above, cross-cluster-efficiency,
;;       scaffolding) are fixed by world-type in setup (ODD §7.11).
;;
;; Data: all output is collected with BehaviorSpace reporters (one table per
;; experiment) and analysed with MUTUS_analysis.R.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  ;; ---- fixed internal parameters (§7.11) ----
  fr-a fr-h              ; attack rate and handling time, Holling type II
  gamma-conv             ; conversion of gain into energy
  eta-low                ; handling efficiency for too-easy resources
  kappa                  ; novelty decay with familiarity (wiki)
  pi0                    ; service factor without carried pollen
 effort-min             ; adaptive foraging: effort floor (M3)
  basal-cost             ; per-tick energy loss
  e-min e-wake r-dorm    ; dormancy thresholds and recovery rate
  delta-v delta-q        ; vitality and quality decay (M2)
  v-min                  ; threshold for an alive resource
  reward-max             ; reward capacity
  cluster-ring-radius    ; radius of the ring of cluster centres
  ;; ---- run bookkeeping ----
  run-id run-seed
  cluster-centers        ; list of [x y]
  ;; ---- counters ----
  total-visits total-fails total-services total-gain
  services-with-pollen cross-services
  band-visits easy-visits          ; v0.4: visits inside / below the ZPD band
  mean-skill-0                     ; v0.4: mean skill at setup
  visit-records                    ; v0.4: "tick:forager:resource" of successful visits
  renewal-count                    ; v0.5: number of renewals in the run
  renewal-records                  ; v0.5: "tick:resource:parent:author:old-c:new-c"
  v-renew                          ; v0.5: vitality of a renewed resource
  visits-this-tick
  ;; ---- monitors (§2.4) ----
  share-active-foragers share-alive-resources
  mean-quality mean-energy mean-skill
  fail-rate service-rate cross-cluster-share
  mean-gain-per-visit unique-links connectance-obs
  ;; ---- world parameters, fixed by world-type (§7.11) ----
  zpd-below zpd-above              ; ZPD band: tolerance below / above
  cross-cluster-efficiency         ; pollen / concept transfer between clusters
  scaffolding                      ; quality lowers effective complexity (wiki)
  run-length                       ; one season / semester = 150 ticks
]

;; resources are created first, so their who numbers are 0 .. num-resources - 1
breed [resources resource]
breed [foragers forager]

resources-own [
  res-index        ; = who; index into the foragers' lists
  cluster-id       ; species / topic
  complexity       ; corolla depth / conceptual difficulty, [0,1]
  eff-complexity   ; complexity · (1 − scaffolding · quality)
  reward           ; nectar standing crop / open contribution opportunities
  vitality         ; floral display / currency in course discourse
  quality          ; pollination success / content quality
  visit-count
  service-count
  alive?
  birth-tick       ; v0.5: tick of the last renewal (0 = initial resource)
  generation       ; v0.5: number of renewals of this slot
]

foragers-own [
  activity         ; probability of acting in a tick
  energy           ; energy reserve / motivation, [0,1]
  skill            ; handling skill (meadow) / competence (wiki), [0,1]
  skill-0          ; v0.4: skill at setup
  cheater?         ; reserved (nectar robber / read-only student); false in v1.0
  effort           ; list over resources, sums to 1 (used from M3)
  familiarity      ; list over resources: number of visits (wiki novelty)
  succ-visits      ; list over resources: number of successful visits
  mean-gain        ; running mean of gains (used from M3)
  prev-resource    ; source of carried pollen / concepts
  active?
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; SETUP (§5)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to setup
  clear-all
  check-ladder
  setup-constants
  apply-world-defaults                            ; C5 (v1.0: always)
  setup-seed
  setup-landscape
  setup-clusters
  setup-resources
  setup-foragers
  setup-development                               ; v0.4
  update-monitors
  reset-ticks
end

;; All levels M0–M5a are implemented; any combination of switches is allowed.
;; Without trait-matching? the ZPD band is undefined, so M4 does nothing;
;; without feedback? resources never fade, so M5a does nothing.
to check-ladder
end

to setup-constants
  set fr-a 2
  set fr-h 1
  set gamma-conv 0.5
  set eta-low 0.3
  set kappa 0.3
  set pi0 ifelse-value world-type = "meadow" [ 0 ] [ 0.5 ]
  set effort-min 0.001
  set basal-cost 0.005
  set e-min 0.05
  set e-wake 0.3
  set r-dorm 0.002
  set delta-v 0.02                ; v0.2: was 0.01 (an unvisited resource now falls
                                  ; below v-min in ~80 ticks, i.e. within a semester)
  set delta-q ifelse-value world-type = "meadow" [ 0 ] [ 0.003 ]
  set v-min 0.1
  set reward-max 1
  set cluster-ring-radius 12
  set v-renew 0.3                 ; v0.5: renewed resource starts above v-min
  set run-length 150              ; v1.0: one season / semester
end

;; World parameters of ODD §7.11 (clarification C5).
to apply-world-defaults
  ifelse world-type = "meadow" [
    set zpd-below 0.30
    set zpd-above 0.05
    set cross-cluster-efficiency 0.2
    set scaffolding 0
  ] [
    set zpd-below 0.20
    set zpd-above 0.20
    set cross-cluster-efficiency 0.8
    set scaffolding 0.5
  ]
end

to setup-seed
  ifelse behaviorspace-run-number > 0 [
    set run-id behaviorspace-run-number
    set run-seed behaviorspace-run-number
  ] [
    set run-id 0
    set run-seed new-seed
  ]
  random-seed run-seed
end

to setup-landscape
  ask patches [ set pcolor ifelse-value world-type = "meadow" [ 58 ] [ 9.5 ] ]
end

to setup-clusters
  set cluster-centers n-values cluster-count [ k ->
    (list (cluster-ring-radius * sin (360 * k / cluster-count))
          (cluster-ring-radius * cos (360 * k / cluster-count))) ]
end

to setup-resources
  create-resources num-resources [
    set res-index who
    set cluster-id who mod cluster-count
    let c item cluster-id cluster-centers
    setxy (clamp-x (item 0 c + random-normal 0 cluster-spread))
          (clamp-y (item 1 c + random-normal 0 cluster-spread))
    set complexity random-beta 2 2
    set quality 0.1
    set vitality 0.5
    set reward reward-max
    set visit-count 0
    set service-count 0
    update-eff-complexity
    set alive? true
    set birth-tick 0                                ; v0.5
    set generation 0                                ; v0.5
    set shape ifelse-value world-type = "meadow" [ "flower" ] [ "square" ]
    style-resource
  ]
end

to setup-foragers
  create-foragers num-foragers [
    set activity clip (random-beta (activity-mean * activity-concentration)
                                   ((1 - activity-mean) * activity-concentration))
                      0.01 0.99
    set skill ifelse-value world-type = "meadow"
      [ 0.2 + random-float 0.7 ]      ; handling skill (proboscis + learning)
      [ random-beta 2 3 ]             ; novice-heavy study group
    set energy 0.6
    set active? true
    set cheater? false
    set effort n-values num-resources [ 1 / num-resources ]
    set familiarity n-values num-resources [ 0 ]
    set succ-visits n-values num-resources [ 0 ]
    set mean-gain 0
    set prev-resource nobody
    move-to one-of resources                                   ; clarification C2
    setxy (clamp-x (xcor + random-normal 0 1)) (clamp-y (ycor + random-normal 0 1))
    set shape ifelse-value world-type = "meadow" [ "bug" ] [ "person" ]
    set size 1.4
    style-forager
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; GO (§3.1)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to go
  if ticks >= run-length [ stop ]                               ; step 1
  set visits-this-tick 0
  ask foragers [ forager-step ]                   ; step 2 (random order)
  update-resources                                ; step 3
  update-monitors                                 ; step 4
  tick                                            ; step 5
  if ticks >= run-length [ stop ]
end

;; One forager, one tick (§3.1, step 2).
to forager-step
  if not active? [
    rest
    style-forager
    stop
  ]
  if random-float 1 < activity [ forage ]
  set energy max list 0 (energy - basal-cost)
  if energy < e-min [ set active? false ]
  style-forager
end

;; §7.8 — dormant foragers recover slowly and reactivate at e-wake.
to rest
  set energy energy + r-dorm
  if energy >= e-wake [ set active? true ]
end

;; §7.1–7.2
to forage
  let perceived resources in-radius perception-radius
  if not any? perceived [
    rt random 360
    if can-move? 1 [ fd 1 ]
    stop                                          ; the opportunity is lost
  ]
  let target choose-resource perceived
  move-to target
  visit target
end
;; §7.2 — partner choice: roulette with weight W_ik = A_ik · V_k, where
;;   A_ik = effort_ik  if adaptive-foraging? (M3), otherwise 1;
;;   V_k  = vitality_k if feedback? (M2),         otherwise 1.
;; M0–M1: neutral choice. M2: choice follows vitality (floral display /
;; visibility of the article). M3: choice also follows the forager's own
;; experience.
to-report choose-resource [ candidates ]
  if not (feedback? or adaptive-foraging?) [ report one-of candidates ]
  let cand sort candidates
  let w map [ r -> (ifelse-value adaptive-foraging? [ item ([res-index] of r) effort ] [ 1 ])
                 * (ifelse-value feedback? [ [vitality] of r ] [ 1 ]) ] cand
  let total sum w
  if total <= 0 [ report one-of candidates ]
  let x random-float total
  let i 0
  let acc item 0 w
  while [ acc < x and i < length w - 1 ] [
    set i i + 1
    set acc acc + item i w
  ]
  report item i cand
end



;; §7.3–7.5 — one visit of the calling forager to resource r.
to visit [ r ]
  let idx [res-index] of r
  let d ([eff-complexity] of r) - skill
  let eta handling-efficiency d

  ;; §7.4 consumption, Holling type II
  let novelty ifelse-value world-type = "wiki"
    [ exp (0 - kappa * item idx familiarity) ] [ 1 ]
  let rw [reward] of r
  let g eta * novelty * fr-a * rw / (1 + fr-a * fr-h * rw)
  set g min list g rw
  ask r [
    set reward reward - g
    set visit-count visit-count + 1
  ]

  ;; §7.3 / §7.5 outcome
  let outcome "consume"
  ifelse eta = 0 [
    set outcome "fail"
    set total-fails total-fails + 1
  ] [
    if (not cheater?) and (random-float 1 < energy) [
      set outcome "service"
      deliver-service r
    ]
  ]

  ;; §7.8 energy
  set energy clip (energy + gamma-conv * g - visit-cost) 0 1

  ;; bookkeeping
  if world-type = "wiki" [
    set familiarity replace-item idx familiarity (item idx familiarity + 1)
  ]
  if eta > 0 [
    set succ-visits replace-item idx succ-visits (item idx succ-visits + 1)
    set prev-resource r                           ; clarification C3
  ]
  if eta = 1 and trait-matching? [ set band-visits band-visits + 1 ]   ; v0.4
  if eta > 0 and eta < 1 [ set easy-visits easy-visits + 1 ]           ; v0.4
  if eta > 0 [ set visit-records lput (word ticks ":" who ":" idx) visit-records ]  ; v0.4
  if trait-development? [ develop-skill d novelty ] ; v0.4: M4
  if adaptive-foraging? [ update-effort idx g ]   ; M3
  set total-visits total-visits + 1
  set total-gain total-gain + g
  set visits-this-tick visits-this-tick + 1
end

;; §7.3 — ZPD band as trait matching.
to-report handling-efficiency [ d ]
  if not trait-matching? [ report 1 ]             ; M0
  if d > zpd-above [ report 0 ]                   ; beyond the ZPD: fail
  if d < (0 - zpd-below) [ report eta-low ]       ; too easy
  report 1                                        ; within the band
end

;; §7.5 — service with carried pollen. In M0–M1 service is counted
;; but does not change the resource (commensal control, C1).
to deliver-service [ r ]
  let pf pollen-factor r
  set total-services total-services + 1
  if prev-resource != nobody [
    set services-with-pollen services-with-pollen + 1
    if [cluster-id] of prev-resource != [cluster-id] of r [
      set cross-services cross-services + 1
    ]
  ]
  ask r [ set service-count service-count + 1 ]
  if feedback? [ apply-feedback r pf ]            ; M2
end

to-report pollen-factor [ r ]
  if prev-resource = nobody [ report pi0 ]
  if [cluster-id] of prev-resource = [cluster-id] of r [ report 1 ]
  report cross-cluster-efficiency
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; MECHANISMS M2–M4
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; M2 (§7.5) — the service returns to the resource:
;;   quality_k  ← quality_k  + φ · skill_i · π · (1 − quality_k)
;;   vitality_k ← vitality_k + φ · π · (1 − vitality_k)
;; φ = mutualism-strength, π = pollen factor (pollen-factor).
to apply-feedback [ r pf ]
  let s skill
  ask r [
    set quality  quality  + mutualism-strength * s * pf * (1 - quality)
    set vitality vitality + mutualism-strength * pf * (1 - vitality)
  ]
end

;; M3 (§7.6) — adaptive foraging (discrete replicator form of Valdovinos et al. 2013):
;;   effort_ik ← effort_ik · max(0, 1 + G-af · (G_ik − mean-gain_i))
;;   floor effort-min, renormalise to Σ = 1;
;;   mean-gain_i ← 0.9 · mean-gain_i + 0.1 · G_ik
;; G-af = adaptation-rate (slider). A visit better than the forager's usual
;; raises the effort on that resource, a worse one (e.g. a failed visit, G = 0)
;; lowers it; at high rates one failure drops the effort to the floor.
to update-effort [ idx g ]
  let factor max list 0 (1 + adaptation-rate * (g - mean-gain))
  set effort replace-item idx effort (item idx effort * factor)
  set effort map [ x -> max list effort-min x ] effort
  let total sum effort
  set effort map [ x -> x / total ] effort
  set mean-gain 0.9 * mean-gain + 0.1 * g
end

;; M4 (§7.7) — trait development inside the ZPD band (v0.4):
;;   if −w ≤ d ≤ z:  skill ← skill + λ · ν · (d + w)/(z + w) · (1 − skill)
;; λ = skill-growth (slider), w = zpd-below, z = zpd-above, ν = novelty of the
;; visit (= 1 in the meadow; exp(−κ·familiarity) in the wiki: re-reading the
;; same text teaches less). Learning is maximal at the upper edge of the band
;; (d = z), zero at its lower edge, and absent for failed (d > z) and too-easy
;; (d < −w) visits. (1 − skill) gives saturation.
to develop-skill [ d nu ]
  if not trait-matching? [ stop ]
  if d > zpd-above or d < (0 - zpd-below) [ stop ]
  let span zpd-above + zpd-below
  if span <= 0 [ stop ]
  set skill skill + skill-growth * nu * ((d + zpd-below) / span) * (1 - skill)
end

;; v0.4 — remember initial skills and start the visit record.
to setup-development
  ask foragers [ set skill-0 skill ]
  set mean-skill-0 mean [skill] of foragers
  set visit-records []
  set renewal-records []                          ; v0.5
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ENVIRONMENT (§7.9–7.10)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-resources
  ask resources [
    ifelse feedback? [
      ;; M2 (§7.10): a living resource regenerates reward; unattended
      ;; resources fade (vitality) and become outdated (quality, wiki).
      set reward reward + regeneration-rate * vitality * (reward-max - reward)
      set vitality vitality * (1 - delta-v)
      set quality  quality  * (1 - delta-q)
    ] [
      set reward reward-max                       ; clarification C1
    ]
    update-eff-complexity
    set alive? vitality >= v-min
    style-resource
  ]
  if renewal? and feedback? [ renew-resources ]   ; v0.5: M5a
end

;; M5a (v0.5) — renewal of faded resources in their own slot.
;; Each tick a resource that is not alive is renewed with probability
;; renewal-rate. Who sets the complexity of the newcomer is the key contrast:
;;   meadow: a seedling of a living plant of the same cluster (parent chosen
;;           with probability ∝ quality = pollination success); corolla depth
;;           is inherited: c = c_parent + N(0, offspring-sd);
;;   wiki:   a new article written by an active student within
;;           perception-radius (author chosen ∝ skill); the author writes at
;;           the upper edge of his ZPD: c = skill + zpd-above + N(0, offspring-sd).
;; No parent / no author nearby -> no renewal this tick. The slot (index,
;; cluster, position) is kept, so all lists and metrics keep their size.
to renew-resources
  ask resources with [ not alive? ] [
    if random-float 1 < renewal-rate [
      let new-c -1
      let parent-id -1
      let author-id -1
      let found? false
      ifelse world-type = "meadow" [
        let cl cluster-id
        let parents other resources with [ alive? and cluster-id = cl ]
        if any? parents [
          let p roulette (sort parents) map [ x -> [quality] of x ] (sort parents)
          set parent-id [res-index] of p
          set found? true
          set new-c [complexity] of p + random-normal 0 offspring-sd
        ]
      ] [
        let authors foragers in-radius perception-radius with [ active? and not cheater? ]
        if any? authors [
          let a roulette (sort authors) map [ x -> [skill] of x ] (sort authors)
          set author-id [who] of a
          set found? true
          set new-c [skill] of a + zpd-above + random-normal 0 offspring-sd
        ]
      ]
      if found? [
        renew-slot (clip new-c 0.01 0.99) parent-id author-id
      ]
    ]
  ]
end

to renew-slot [ new-c parent-id author-id ]  ; resource procedure
  let idx res-index
  let old-c complexity
  set complexity new-c
  set quality 0.1
  set vitality v-renew
  set reward reward-max
  set visit-count 0
  set service-count 0
  set birth-tick ticks
  set generation generation + 1
  update-eff-complexity
  set alive? true
  style-resource
  ;; a new text is new for everybody; adaptive foragers get a fresh prior on it
  ask foragers [
    set familiarity replace-item idx familiarity 0
    set effort replace-item idx effort (1 / num-resources)
    let total sum effort
    set effort map [ x -> x / total ] effort
  ]
  set renewal-count renewal-count + 1
  set renewal-records lput (word ticks ":" idx ":" parent-id ":" author-id ":"
                                  (precision old-c 4) ":" (precision new-c 4)) renewal-records
end

;; Roulette choice of one item with probability ∝ weight (weights ≥ 0).
to-report roulette [ items weights ]
  let total sum weights
  if total <= 0 [ report one-of items ]
  let x random-float total
  let acc 0
  let i 0
  while [ i < length items ] [
    set acc acc + item i weights
    if x < acc [ report item i items ]
    set i i + 1
  ]
  report last items
end

to update-eff-complexity  ; resource procedure
  set eff-complexity complexity * (1 - scaffolding * quality)
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; OBSERVATION (§2.4, §2.6, §4.11)
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to update-monitors
  set share-active-foragers (count foragers with [active?]) / num-foragers
  set share-alive-resources (count resources with [alive?]) / num-resources
  set mean-quality mean [quality] of resources
  set mean-energy mean [energy] of foragers
  set mean-skill mean [skill] of foragers
  set fail-rate safe-div total-fails total-visits
  set service-rate safe-div total-services total-visits
  set cross-cluster-share safe-div cross-services services-with-pollen
  set mean-gain-per-visit safe-div total-gain total-visits
  set unique-links sum [ length filter [ x -> x > 0 ] succ-visits ] of foragers
  set connectance-obs unique-links / (num-foragers * num-resources)
end


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; BEHAVIORSPACE REPORTERS — one table per experiment
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; These reporters pack the bipartite network and the node attributes into
;; strings, so that a single BehaviorSpace table contains everything needed
;; for network analysis in R. Format: records separated by ";", fields by ":".

;; Effective diet breadth of active foragers: mean of 1 / Σ effort², i.e. the
;; number of resources a forager effectively divides its effort among
;; (= num-resources while effort is uniform; falls as foragers specialise).
to-report effective-diet
  let fs foragers with [active?]
  if not any? fs [ set fs foragers ]
  report mean [ 1 / sum map [ x -> x * x ] effort ] of fs
end

;; Realised diet breadth: mean inverse Simpson index of each forager's
;; successful visits over resources (how many resources it actually uses).
to-report visit-diet
  let fs foragers with [ sum succ-visits > 0 ]
  if not any? fs [ report 0 ]
  report mean [ 1 / sum map [ x -> (x / sum succ-visits) ^ 2 ] succ-visits ] of fs
end

;; Weighted bipartite network of successful visits: "forager:resource:count;..."
to-report web-edgelist
  let parts []
  foreach sort foragers [ f ->
    ask f [
      let i 0
      foreach succ-visits [ n ->
        if n > 0 [ set parts lput (word who ":" i ":" n) parts ]
        set i i + 1
      ]
    ]
  ]
  report join-records parts
end

;; v0.4 (M4) — development reporters.
to-report skill-gain                       ; mean skill now − at setup
  report mean-skill - mean-skill-0
end

to-report share-in-band                    ; visits with d inside the ZPD band
  report safe-div band-visits total-visits
end

to-report share-too-easy                   ; visits with d below the band
  report safe-div easy-visits total-visits
end

;; Skill change per forager: "id:skill0:skill;..."
to-report forager-skills
  report join-records map [ f -> [ (word who ":" (precision skill-0 4) ":"
                                         (precision skill 4)) ] of f ]
                          sort foragers
end

;; All successful visits in time order: "tick:forager:resource;..."
;; (used in R to build networks in time windows, H8).
to-report visit-sequence
  report join-records visit-records
end

;; v0.5 (M5a) — renewal reporters.
to-report share-renewed                    ; slots renewed at least once
  report (count resources with [ generation > 0 ]) / num-resources
end

to-report mean-complexity                  ; all resources, end of run
  report mean [complexity] of resources
end

to-report mean-complexity-alive            ; living resources only
  ifelse any? resources with [ alive? ]
    [ report mean [complexity] of resources with [ alive? ] ]
    [ report 0 ]
end

to-report skill-complexity-gap             ; mean skill of active foragers −
  let fa foragers with [ active? ]         ; mean eff. complexity of living resources
  let ra resources with [ alive? ]
  if not any? fa or not any? ra [ report 0 ]
  report mean [skill] of fa - mean [eff-complexity] of ra
end

;; All renewals: "tick:resource:parent:author:old-c:new-c;..." (−1 = none)
to-report renewal-list
  report join-records renewal-records
end

;; Forager attributes: "id:skill:activity:cheater:active;..."
to-report forager-traits
  report join-records map [ f -> [ (word who ":" (precision skill 4) ":"
                                         (precision activity 4) ":"
                                         (ifelse-value cheater? [ 1 ] [ 0 ]) ":"
                                         (ifelse-value active? [ 1 ] [ 0 ])) ] of f ]
                          sort foragers
end

;; Resource attributes: "id:cluster:complexity:x:y:quality:vitality;..."
to-report resource-traits
  report join-records map [ r -> [ (word res-index ":" cluster-id ":"
                                         (precision complexity 4) ":"
                                         (precision xcor 2) ":" (precision ycor 2) ":"
                                         (precision quality 4) ":"
                                         (precision vitality 4)) ] of r ]
                          sort resources
end

to-report join-records [ parts ]
  if empty? parts [ report "" ]
  report reduce [ [a b] -> (word a ";" b) ] parts
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; VISUALS
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

to style-resource  ; resource procedure
  set color ifelse-value alive? [ item (cluster-id mod 14) base-colors ] [ grey ]
  set size 0.8 + vitality
end

to style-forager  ; forager procedure
  ifelse active? [
    set color ifelse-value world-type = "meadow"
      [ scale-color yellow skill -0.2 1.2 ]
      [ scale-color blue skill -0.2 1.2 ]
  ] [
    set color grey + 2
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; UTILITIES
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Beta(a, b) via two Gamma draws.
to-report random-beta [ a b ]
  let x random-gamma a 1
  let y random-gamma b 1
  report x / (x + y)
end

to-report clip [ x lo hi ]
  report max list lo (min list hi x)
end

to-report clamp-x [ x ]
  report clip x min-pxcor max-pxcor
end

to-report clamp-y [ y ]
  report clip y min-pycor max-pycor
end

to-report safe-div [ a b ]
  report ifelse-value b > 0 [ a / b ] [ 0 ]
end]]></code>
