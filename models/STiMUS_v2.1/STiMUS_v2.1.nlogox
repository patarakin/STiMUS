  <experiments>
    <experiment name="STiMUS_v2.1_E1_explicit_500_50" repetitions="50" sequentialRunOrder="true" runMetricsEveryStep="false" timeLimit="500">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition><![CDATA[ticks >= 500]]></exitCondition>
      <metrics>
        <metric>ESR</metric>
        <metric>coediting-density</metric>
        <metric>mean-quality</metric>
        <metric>mean-resource-value</metric>
        <metric>mutualism-index</metric>
        <metric>task-completion-rate</metric>
        <metric>mean-shared-mental-model</metric>
        <metric>page-diversity</metric>
        <metric>gini-edits</metric>
        <metric>bigraph-edges</metric>
        <metric>total-edits</metric>
        <metric>cross-author-edits</metric>
        <metric><![CDATA[count patches with [edit-count > 0]]]></metric>
        <metric>non-task-active-pages</metric>
        <metric>mean-motivation</metric>
        <metric>benefit-gain-per-edit</metric>
        <metric>mutualism-index-norm</metric>
        <metric>edits-on-tasks</metric>
        <metric>edits-on-non-tasks</metric>
        <metric>task-edit-share</metric>
        <metric>resource-edit-correlation</metric>
        <metric>explicit-edit-share</metric>
        <metric>explicit-hit-rate</metric>
        <metric>explicit-fallback-rate</metric>
        <metric>active-task-count</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="num-contributors">
          <value value="25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="num-tasks">
          <value value="25"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="topic-count">
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="vision-radius">
          <value value="2"></value>
          <value value="5"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="evaporation-rate">
          <value value="0.02"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="diffusion-rate">
          <value value="0.05"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="edit-increment">
          <value value="0.6"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="p-explicit">
          <value value="0"></value>
          <value value="0.1"></value>
          <value value="0.2"></value>
          <value value="0.3"></value>
          <value value="0.4"></value>
          <value value="0.5"></value>
          <value value="0.6"></value>
          <value value="0.7"></value>
          <value value="0.8"></value>
          <value value="0.9"></value>
          <value value="1"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="lambda-smm">
          <value value="0.01"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="mutualism-gain-factor">
          <value value="0.06"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="activity-probability">
          <value value="0.7"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
