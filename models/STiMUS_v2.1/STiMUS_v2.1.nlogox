<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0" snapToGrid="false">
  <code><![CDATA[;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; STIGMERGY + MUTUALISM IN SOCIO-TECHNICAL SYSTEMS  (STiMUS)
;; NetLogo 7 — version 2.1
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; VERSION 2.1 — CHANGELOG / NOTES
;; ----------------------------------
;; v2.1 builds on v2. The v2 structural separation of stigmergy and
;; mutualism is preserved unchanged; v2.1 fixes the one remaining
;; weakness surfaced by the v2 diagnostics and adds reporters that make
;; the explicit-assignment channel measurable.
;;
;; Terminology: MUTUALISM — the mutualistic relationship between
;; contributors and artefact-objects (contributors enrich artefacts;
;; artefacts return benefit that fuels contributor motivation). This is
;; contributor–artefact mutualism, not merely contributor–contributor
;; relations. The term "mutualism" is used throughout.
;;
;; -------------------------------------------------------------------
;; (A) PRESERVED FROM v2 (no change)
;; -------------------------------------------------------------------
;;  (1) resource-value is NOT part of the ACO target-selection weight.
;;      Stigmergy decides WHERE to work (pheromone, incompleteness,
;;      maintenance-need, task flag, topic match); mutualism decides
;;      WITH WHAT EFFORT (resource-value → benefit → motivation →
;;      edit-power → quality). Confirmed by E3 on v2: mutualism no
;;      longer hurts quality (v1 t=10.88, p<0.0001 → v2 n.s.).
;;  (2) task-priority-bonus = 1.25 in the ACO weight for is-task? patches.
;;  (3) specialization-weight = 0.60; topic-match-bonus = 0.50.
;;  (4) All v2 diagnostic reporters (mean-motivation, benefit-gain-per-edit,
;;      mutualism-index-norm, edits-on-tasks, edits-on-non-tasks,
;;      task-edit-share, resource-edit-correlation).
;;
;; -------------------------------------------------------------------
;; (B) NEW IN v2.1 — task-focused explicit assignment
;; -------------------------------------------------------------------
;;  (5) In explicit mode the candidate set is now ONLY task patches:
;;        candidates = visible with [is-task?]
;;      Previously the filter also admitted high-maintenance and
;;      incomplete non-task patches, so even at p-explicit = 1 only
;;      ~4% of edits landed on tasks (E1, v2). Now explicit mode means
;;      "if I can see a formal task, I work on it."
;;      If NO task is visible, the contributor falls back to the
;;      stigmergic rule (aco-choose-patch) and explicit-mode? is set to
;;      false, so the explicit-bonus is not applied to a stigmergic
;;      choice. We deliberately do NOT fall back to "do nothing", because
;;      that would turn p-explicit into an activity-suppression parameter
;;      and confound E1 with activity-probability and total-edits.
;;      Selection among visible tasks is by (task-complexity +
;;      (1 - completeness)) — hardest unfinished task first.
;;
;; -------------------------------------------------------------------
;; (C) NEW IN v2.1 — explicit-channel diagnostics (measurement only)
;; -------------------------------------------------------------------
;;  (6) explicit-attempts-count  — times a contributor entered the
;;      p-explicit branch.
;;  (7) explicit-edits-count     — times explicit mode actually selected
;;      a visible task and the edit was performed.
;;  (8) explicit-fallback-count  — times explicit mode found no visible
;;      task and fell back to stigmergy.
;;  (9) explicit-edit-share      — explicit-edits-count / total-edits.
;;      The share of edits that were genuinely task-assigned.
;; (10) explicit-hit-rate        — explicit-edits-count / explicit-attempts-count.
;;      How often an explicit attempt actually found a task.
;; (11) explicit-fallback-rate   — explicit-fallback-count / explicit-attempts-count.
;;
;; These let us tell whether a change in task-completion is due to
;; explicit assignment actually hitting tasks, or to stigmergic fallback
;; doing the work. Without them, v2's task-edit-share (~4%) was
;; uninterpretable.
;;
;; -------------------------------------------------------------------
;; WHAT IS PRESERVED FROM v1 (unchanged)
;; -------------------------------------------------------------------
;;  - All 11 interface sliders (num-contributors … activity-probability).
;;  - Formulas for edit-power, local-benefit, pheromone dynamics.
;;  - All v1 reporters (page-diversity, gini-edits, non-task-active-pages,
;;    the fixed task-completion-rate, etc.).
;;  - Default behaviour reproduces v2 except for the deliberately
;;    changed explicit-mode filter (5); therefore v2.1 runs are NOT
;;    seed-identical to v2 — this is expected and desirable.
;;
;; -------------------------------------------------------------------
;; OPEN QUESTIONS (not implemented, flagged only)
;; -------------------------------------------------------------------
;;  (Q1) Dynamic vision-radius, scaled with shared-mental-model.
;;  (Q2) lambda-smm weighted by the quality of the target artefact.
;;  (Q3) ESR in a sliding window (ring buffer).
;;  (Q4) Two ESR metrics (event-level global ESR and patch-level esr-value)
;;       coexist — documented, not unified.
;;  (Q5) edit-authors stores unique authors, not chronology.
;;  (Q6) Individual activity-rate (for genuine participation inequality).
;;  (Q7) A was-task? patch variable to distinguish "edited patches that
;;       were never tasks" from "edited patches whose task is complete".
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

globals [
  total-edits            ; cumulative count of all edit events
  cross-author-edits     ; cumulative count of edits where the previous editor differed
  ESR                    ; event-level Edit Succession Ratio = cross-author-edits / total-edits
  mean-quality           ; mean patch quality
  mean-resource-value    ; mean patch resource-value
  mutualism-index        ; (mean contributor benefit-gain + mean-resource-value) / 2
  coediting-density      ; density of the co-editing network
  active-pages-share     ; share of patches with at least one edit
  edge-log               ; bipartite edit log: list of (tick, who, pageid, specialty, topic-tag, quality)
  initial-task-count     ; v1 — number of patches flagged is-task? at setup (for task-completion-rate)
  tasks-completed        ; v1 — running count of tasks that have reached the completion threshold
  edits-on-tasks-count   ; v2 — running count of edits on active (is-task?) patches
  explicit-attempts-count ; v2.1 — times a contributor entered the p-explicit branch
  explicit-edits-count   ; v2.1 — times explicit mode actually selected and edited a visible task
  explicit-fallback-count ; v2.1 — times explicit mode found no visible task and fell back to stigmergy
]

breed [contributors contributor]
undirected-link-breed [coedits coedit]

patches-own [
  pheromone          ; stigmergic trace intensity; diffuses and evaporates
  quality            ; content quality in [0,1]
  completeness       ; task/content completion in [0,1]
  recentness         ; ticks since last edit (initialised to 9999)
  last-editor-id     ; who of the most recent editor, or -1
  edit-count         ; total edits received
  edit-authors       ; list of UNIQUE authors (deduplicated, not a full history)
  is-task?           ; is this patch a designated task?
  task-complexity    ; complexity in [0,1]
  resource-value     ; mutualistic benefit available to visitors in [0,1]
  reuse-count        ; number of reuse/edit events
  maintenance-need   ; degradation accumulator in [0,1]; grows when unattended
  topic-tag          ; domain index in [0, topic-count-1]
]

contributors-own [
  skill                  ; competence in [0.3,1.0]
  motivation             ; engagement in [0.05,1.0]; updated over time
  shared-mental-model    ; proxy for team shared understanding in [0,1]
  specialty              ; preferred topic index in [0, topic-count-1]
  my-last-page           ; last edited patch or nobody
  my-edit-count          ; contributor's total edits
  benefit-gain           ; cumulative benefit obtained from artefacts
  explicit-mode?         ; did the current step use explicit task assignment?
]

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; fixed internal parameters
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Exponent on the pheromone factor in the ACO-style target weight.
; Larger than beta-heuristic, so "recent activity" attracts more than "mere incompleteness".
to-report alpha-pheromone
  report 1.6
end

; Exponent on the (1 - completeness) factor in the ACO-style target weight.
to-report beta-heuristic
  report 1.3
end

; v2 — Multiplicative bonus applied to the target weight when the patch topic
; matches the contributor's specialty. Raised 0.35 → 0.60 so that topics
; become a meaningful lever (E5 showed zero effect at 0.35).
to-report specialization-weight
  report 0.60
end

; v2 — Multiplicative bonus on edit-power when the patch topic matches specialty.
; Raised 0.30 → 0.50 (in parallel with specialization-weight) so that
; specialisation affects not only target choice but also edit power.
to-report topic-match-bonus
  report 0.50
end

; Multiplicative bonus on edit-power when the contributor is in explicit mode.
to-report explicit-effect
  report 0.10
end

; Logistic gain coefficient for quality per edit: q + factor*power*(1 - q).
to-report quality-gain-factor
  report 0.08
end

; Logistic gain coefficient for completeness per edit.
to-report completeness-gain-factor
  report 0.05
end

; Reduction of maintenance-need per edit, scaled by edit-power.
to-report maintenance-relief-factor
  report 0.08
end

; Per-tick drift of maintenance-need on every patch.
to-report maintenance-drift
  report 0.010
end

; Per-tick decay of resource-value, proportional to maintenance-need.
to-report resource-decay
  report 0.003
end

; Motivation recovery rate, proportional to local benefit drawn from the artefact.
to-report motivation-recovery
  report 0.03
end

; Fixed motivation fatigue subtracted every edit.
to-report motivation-fatigue
  report 0.005
end

; Weight of resource-value in the local-benefit formula.
to-report resource-benefit-weight
  report 0.40
end

; Weight of quality in the local-benefit formula.
to-report quality-benefit-weight
  report 0.20
end

; Weight of topic match in the local-benefit formula.
to-report topic-benefit-weight
  report 0.30
end

; Completeness threshold above which a task is considered complete.
to-report task-completion-threshold
  report 0.90
end

; v2 — Task priority bonus in stigmergic target selection.
; Formal tasks (is-task? = true) receive this multiplier in the ACO weight
; so they are not "starved" in stigmergic mode (E1: task-completion fell as
; p-explicit rose, because is-task? was not part of the target weight).
; The value 1.25 is moderate: tasks are visible as affordances but do not
; overwhelm pheromone / completeness / need.
to-report task-priority-bonus
  report 1.25
end

; v1 — Number of DISTINCT contributor-page pairs in the edge log
; (not the number of log rows, which counts repeated edits on the same pair).
to-report bigraph-edges
  report length remove-duplicates
    map [[e1] -> (list (item 1 e1) (item 2 e1))] edge-log
end

; Number of patches that have been edited at least once.
to-report active-pages
  report count patches with [edit-count > 0]
end

; Number of contributors that have edited at least once.
to-report active-authors
  report count contributors with [my-edit-count > 0]
end

; v1 — Number of edited patches that are NOT current tasks.
; Named reporter for the BehaviourSpace expression
; count patches with [not is-task? and edit-count > 0].
; NOTE: completed tasks (is-task? set to false on completion) ARE
; counted here, matching the original BehaviourSpace expression.
; If you want "edited patches that were NEVER tasks", a patch
; variable such as was-task? would be needed (open question Q7).
to-report non-task-active-pages
  report count patches with [not is-task? and edit-count > 0]
end

; Patch-level Edit Succession Ratio: share of edited patches whose
; edit-authors list contains more than one unique author.
; NOTE: this is NOT the same as the global ESR (event-level).
to-report esr-value
  let edited patches with [edit-count > 0]
  if not any? edited [ report 0 ]
  report (count edited with [length remove-duplicates edit-authors > 1]) /
         count edited
end

; Alias for the global mutualism-index (kept for interface/plot convenience).
to-report mutualism-idx
  report mutualism-index
end

; v1 — Page diversity: normalised Shannon entropy of the edit-count
; distribution across the patches that have been edited.
;   0 = all edits concentrated on a single patch
;   1 = edits perfectly evenly spread across active patches
; Normalised by ln(active-pages), so the reference set is "edited pages".
; REVIEW: if comparability across runs with different world sizes is
; needed, normalise by ln(count patches) instead.
to-report page-diversity
  let edited patches with [edit-count > 0]
  let k count edited
  if total-edits = 0 or k <= 1 [ report 0 ]
  let h 0
  ask edited [
    let p edit-count / total-edits
    set h h - (p * ln p)
  ]
  report h / ln k
end

; v1 — Gini coefficient of my-edit-count across ALL contributors
; (including zero-edit contributors), measuring participation inequality.
; 0 = perfectly equal participation; approaches 1 as participation
; concentrates on a single contributor (finite-sample max is
; (n - 1) / n, i.e. 0.95 for 20 contributors).
; NOTE: with the default tick structure (every contributor acts every
; tick) this stays near 0. It becomes informative when
; activity-probability < 1 or when some contributors are starved of
; visible patches.
to-report gini-edits
  if not any? contributors [ report 0 ]
  let xs sort [my-edit-count] of contributors
  let n length xs
  if n = 0 [ report 0 ]
  let total sum xs
  if total = 0 [ report 0 ]
  let weighted-sum 0
  let i 1
  foreach xs [ x ->
    set weighted-sum weighted-sum + (i * x)
    set i i + 1
  ]
  report ((2 * weighted-sum) / (n * total)) - ((n + 1) / n)
end

;; ===========================================================
;; v2 — DIAGNOSTIC REPORTERS (measurement only, dynamics unchanged)
;; ===========================================================

; v2 — Mean motivation of contributors. Shows whether the channel
; resource-value → benefit → motivation → edit-power works. If mutualism
; is enabled, mean-motivation should rise with mutualism-gain-factor.
to-report mean-motivation
  if not any? contributors [ report 0 ]
  report mean [motivation] of contributors
end

; v2 — Normalised return: benefit-gain / my-edit-count.
; Unlike the cumulative mutualism-index, it is comparable across runs of
; different length. It rises when artefacts become "richer" and each edit
; brings more benefit.
to-report benefit-gain-per-edit
  let active contributors with [my-edit-count > 0]
  if not any? active [ report 0 ]
  report mean [benefit-gain / my-edit-count] of active
end

; v2 — Normalised mutualism index:
;   (mean benefit-gain-per-edit + mean-resource-value) / 2.
; Comparable across runs of different length, unlike the cumulative
; mutualism-index (which grows with the number of edits).
to-report mutualism-index-norm
  report (benefit-gain-per-edit + mean [resource-value] of patches) / 2
end

; v2 — Number of edits on formal tasks (counted in perform-edit).
; Note: is-task? is reset on completion, so edits on already-completed
; tasks are not counted here — this is "edits on active tasks".
to-report edits-on-tasks
  report edits-on-tasks-count
end

; v2 — Number of edits on non-task patches (including completed tasks,
; since their is-task? is already false).
to-report edits-on-non-tasks
  report total-edits - edits-on-tasks-count
end

; v2 — Share of edits going onto active formal tasks.
; A low share means the team is working past its tasks.
to-report task-edit-share
  if total-edits = 0 [ report 0 ]
  report edits-on-tasks-count / total-edits
end

; v2 — Pearson correlation between resource-value and edit-count across
; patches. A direct test of the preferential-attachment hypothesis: in v1
; it was high (resource-value attracted edits); after the v2 fix it
; should drop closer to 0 (and be exactly 0 when mutualism is off,
; because resource-value then decays to 0 everywhere).
to-report resource-edit-correlation
  let edited patches with [edit-count > 0]
  if count edited < 2 [ report 0 ]

  let pairs [ (list resource-value edit-count) ] of edited
  let rvs map [pair -> item 0 pair] pairs
  let ecs map [pair -> item 1 pair] pairs

  let mr mean rvs
  let me mean ecs

  let ss-r sum (map [pair -> (((item 0 pair) - mr) ^ 2)] pairs)
  let ss-e sum (map [pair -> (((item 1 pair) - me) ^ 2)] pairs)

  if (ss-r = 0) or (ss-e = 0) [ report 0 ]

  let num sum (map [pair -> (((item 0 pair) - mr) * ((item 1 pair) - me))] pairs)
  let den sqrt (ss-r * ss-e)

  report num / den
end

;; ===========================================================
;; v2.1 — EXPLICIT-CHANNEL DIAGNOSTIC REPORTERS (measurement only)
;; ===========================================================

; v2.1 — Share of edits that were genuinely task-assigned (the contributor
; entered explicit mode AND found a visible task AND edited it). In v2.1
; this should rise sharply with p-explicit, unlike v2's task-edit-share
; which stayed near 4%.
to-report explicit-edit-share
  if total-edits = 0 [ report 0 ]
  report explicit-edits-count / total-edits
end

; v2.1 — Of all explicit attempts, the fraction that actually found a
; visible task. Low values mean formal tasks are often out of sight
; (vision-radius too small or tasks already completed), so explicit
; assignment keeps falling back to stigmergy.
to-report explicit-hit-rate
  if explicit-attempts-count = 0 [ report 0 ]
  report explicit-edits-count / explicit-attempts-count
end

; v2.1 — Of all explicit attempts, the fraction that found NO visible task
; and fell back to stigmergic choice. Complements explicit-hit-rate.
to-report explicit-fallback-rate
  if explicit-attempts-count = 0 [ report 0 ]
  report explicit-fallback-count / explicit-attempts-count
end

; v2.1 — Number of patches still flagged as active tasks.
; Distinguishes "explicit fallback because no task is visible" from
; "fallback because all tasks are already completed": if this hits 0
; early in a run, later explicit attempts will fall back to stigmergy
; even though the assignment mechanism works perfectly.
to-report active-task-count
  report count patches with [is-task?]
end

; Return the full bipartite edit log as a CSV string (header + rows).
to-report edge-log-csv
  let header "tick,author_id,pageid,specialty,topic_tag,quality\n"
  let rows map [[e1] ->
    (word (item 0 e1) "," (item 1 e1) "," (item 2 e1) ","
          (item 3 e1) "," (item 4 e1) "," (precision (item 5 e1) 4))
  ] edge-log

  if empty? rows [ report header ]

  report (word header (reduce [[a b] -> (word a "\n" b)] rows))
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; setup
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Initialise the world: clear everything, reset globals and the edit
; log, then create patches and contributors. The v1 counters
; (initial-task-count, tasks-completed), the v2 counter
; (edits-on-tasks-count) and the v2.1 counters (explicit-*) are reset here.
to setup
  clear-all
  set total-edits 0
  set cross-author-edits 0
  set ESR 0
  set mean-quality 0
  set mean-resource-value 0
  set mutualism-index 0
  set coediting-density 0
  set active-pages-share 0
  set edge-log []
  set initial-task-count 0      ; v1
  set tasks-completed 0         ; v1
  set edits-on-tasks-count 0   ; v2
  set explicit-attempts-count 0  ; v2.1
  set explicit-edits-count 0     ; v2.1
  set explicit-fallback-count 0  ; v2.1
  setup-patches
  setup-contributors
  reset-ticks
end

; Initialise every patch's stigmergic and mutualistic state, then flag
; num-tasks patches as tasks. v1: record initial-task-count so that
; task-completion-rate has the correct denominator.
to setup-patches
  ask patches [
    set pheromone 0
    set quality random-float 0.15
    set completeness random-float 0.20
    set recentness 9999
    set last-editor-id -1
    set edit-count 0
    set edit-authors []
    set is-task? false
    set task-complexity random-float 1
    set resource-value 0.2 + random-float 0.2
    set reuse-count 0
    set maintenance-need random-float 0.3
    set topic-tag random topic-count
    recolor-patch
  ]

  ask n-of num-tasks patches [
    set is-task? true
    set task-complexity 0.4 + random-float 0.6
    set pcolor orange
  ]
  ; v1 — count actual flagged patches (robust if num-tasks > patch count).
  set initial-task-count count patches with [is-task?]
end

; Create num-contributors agents with random initial state placed at
; random positions. All start in stigmergic (green) mode.
to setup-contributors
  create-contributors num-contributors [
    setxy random-xcor random-ycor
    set shape "person"
    set size 1.2
    set color green
    set skill 0.3 + random-float 0.7
    set motivation 0.4 + random-float 0.6
    set shared-mental-model 0.1 + random-float 0.1
    set specialty random topic-count
    set my-last-page nobody
    set my-edit-count 0
    set benefit-gain 0
    set explicit-mode? false
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; main loop
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; One tick = one "session". Every contributor (subject to
; activity-probability, v1) chooses a target, moves to it and edits it.
; Afterwards the environment is updated globally: pheromone diffuses
; and evaporates, artefacts age and degrade, then metrics are recomputed.
to go
  if not any? contributors [ stop ]

  ask contributors [
    ; v1 — probabilistic activation. At activity-probability = 1.0
    ; (default) the fast path is taken WITHOUT consuming a random
    ; number, so the original random stream is preserved and runs are
    ; seed-identical to the previous validated release.
    ifelse activity-probability >= 1 [
      step-contributor
    ] [
      if random-float 1 < activity-probability [
        step-contributor
      ]
    ]
  ]

  diffuse pheromone diffusion-rate

  ask patches [
    set pheromone pheromone * (1 - evaporation-rate)
    if pheromone < 0 [ set pheromone 0 ]
    set recentness recentness + 1
    set maintenance-need min (list 1 (maintenance-need + maintenance-drift))
    set resource-value max (list 0 (resource-value - resource-decay * maintenance-need))
    recolor-patch
  ]

  update-metrics
  tick
end

; A single contributor cycle: choose a target patch, move to it, edit it.
to step-contributor
  let target choose-target-page
  if target != nobody [
    move-to target
    perform-edit target
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; choice logic
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Decide which patch the contributor will work on this tick.
; With probability p-explicit it enters explicit (assigned-task) mode:
;   v2.1 — candidates are ONLY visible task patches (is-task?). If any
;   are visible, pick the hardest unfinished one. If NO task is visible,
;   fall back to the stigmergic rule (aco-choose-patch) and clear
;   explicit-mode? so the explicit-bonus is not applied. This makes
;   "explicit mode" genuinely mean "I was assigned to and found a task";
;   previously the wide filter let non-task patches leak in and only
;   ~4% of explicit-mode edits landed on tasks.
; Otherwise (probability 1 - p-explicit) it uses the stigmergic ACO rule.
; REVIEW (Q1): vision-radius is constant for all contributors. One could
;   scale it with shared-mental-model so well-integrated contributors
;   see more. Not enabled by default.
to-report choose-target-page
  let visible patches in-radius vision-radius
  if not any? visible [ report nobody ]

  ifelse random-float 1 < p-explicit [
    ; v2.1 — entered the explicit branch (an "attempt")
    set explicit-attempts-count explicit-attempts-count + 1
    let task-candidates visible with [is-task?]
    ifelse any? task-candidates [
      set explicit-mode? true
      set color yellow
      report max-one-of task-candidates [task-complexity + (1 - completeness)]
    ] [
      ; v2.1 — no visible task: fall back to stigmergy, do NOT apply the
      ; explicit bonus. We avoid "do nothing" so p-explicit does not
      ; become an activity-suppression parameter.
      set explicit-fallback-count explicit-fallback-count + 1
      set explicit-mode? false
      set color green
      report aco-choose-patch visible
    ]
  ] [
    set explicit-mode? false
    set color green
    report aco-choose-patch visible
  ]

end

; Stigmergic target choice: among visible patches that are still worth
; working on (incomplete or in need of maintenance), pick the one that
; maximises the ACO-style weight
;   (pheromone+0.01)^alpha * (1-completeness+0.01)^beta
;   * (1 + maintenance-need) * task-factor * topic-match-factor.
; v2: resource-value REMOVED from the weight (previously 1 + resource-value +
;   maintenance-need). Now stigmergy decides only WHERE to work — by
;   pheromone, incompleteness and maintenance need; resource-value no
;   longer attracts edits to mature artefacts. Mutualism acts separately,
;   through benefit→motivation→edit-power.
; v2: added task-priority-bonus for is-task? patches.
; Selection is deterministic (max-one-of), not a probabilistic roulette.
to-report aco-choose-patch [candidate-patches]
  let weighted-patches candidate-patches with [completeness < 1 or maintenance-need > 0.05]
  if not any? weighted-patches [ report one-of candidate-patches ]

  report max-one-of weighted-patches
  [
    ((pheromone + 0.01) ^ alpha-pheromone) *
    (((1 - completeness) + 0.01) ^ beta-heuristic) *
    (1 + maintenance-need) *
    (ifelse-value is-task? [task-priority-bonus] [1]) *
    (ifelse-value (topic-tag = [specialty] of myself)
      [1 + specialization-weight]
      [1])
  ]
end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; editing
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Apply one edit to the target patch and update the editor's state and
; the co-editing network. Three processes happen together: the artefact
; changes, the shared mental model / co-editing link grows, and the
; contributor's benefit/motivation is updated.
to perform-edit [target]
  let previous-editor-id [last-editor-id] of target
  let previous-authors [edit-authors] of target
  let target-was-task? [is-task?] of target   ; v2 — capture before editing (is-task? may flip to false)
  let topic-match ifelse-value ([topic-tag] of target = specialty) [1] [0]
  let explicit-bonus ifelse-value explicit-mode? [explicit-effect] [0]
  let edit-power skill * (0.5 + 0.5 * motivation) * (1 + topic-match * topic-match-bonus + explicit-bonus)

  ; v2.1 — if this edit was made in explicit mode, the explicit channel
  ; actually hit a task. Count it (only happens when a visible task was
  ; selected in choose-target-page; explicit-mode? is cleared on fallback).
  if explicit-mode? [
    set explicit-edits-count explicit-edits-count + 1
  ]

  ; --- 4a. Change the artefact (stigmergic + mutualistic layers) ---
  ask target [
    set pheromone pheromone + edit-increment
    set quality min (list 1 (quality + quality-gain-factor * edit-power * (1 - quality)))
    set completeness min (list 1 (completeness + completeness-gain-factor * edit-power * (1 - completeness)))
    set recentness 0
    set edit-count edit-count + 1
    set reuse-count reuse-count + 1
    set resource-value min (list 1 (resource-value + mutualism-gain-factor * edit-power * (1 - resource-value)))
    set maintenance-need max (list 0 (maintenance-need - maintenance-relief-factor * edit-power))
    set edit-authors remove-duplicates lput [who] of myself edit-authors
    set last-editor-id [who] of myself
    ; v1 — increment tasks-completed exactly once when a task crosses the
    ; threshold. Setting is-task? false prevents double counting.
    if is-task? and completeness >= task-completion-threshold [
      set is-task? false
      set tasks-completed tasks-completed + 1   ; v1
    ]
  ]

  ; --- 4b. Shared mental model and co-editing links ---
  ; If the previous editor was a different contributor, this is a
  ; cross-author succession: count it, grow SMM, and link the two editors.
  ; REVIEW (Q2): lambda-smm is constant; one could weight it by target
  ;   quality (lambda-smm * [quality] of target) to model how much
  ;   context the previous edit transmitted. Not enabled by default.
  if previous-editor-id >= 0 and previous-editor-id != who [
    set cross-author-edits cross-author-edits + 1
    set shared-mental-model min (list 1 (shared-mental-model + lambda-smm))
    let prev-agent turtle previous-editor-id
    if prev-agent != nobody and prev-agent != self [
      if not link-neighbor? prev-agent [
        create-coedit-with prev-agent [
          set color gray
          set thickness 0.1
        ]
      ]
    ]
  ]

  ; Link the editor to every other prior author of this artefact too,
  ; so the co-editing network reflects shared work, not only succession.
  if length previous-authors > 0 [
    let other-authors remove who previous-authors
    foreach other-authors [ a ->
      let other-agent turtle a
      if other-agent != nobody and other-agent != self [
        if not link-neighbor? other-agent [
          create-coedit-with other-agent [
            set color gray
            set thickness 0.1
          ]
        ]
      ]
    ]
  ]

  ; --- 4c. Benefit and motivation update ---
  ; REVIEW (Q3): ESR/mutualism-index are cumulative over the whole run;
  ;   a sliding-window version would better reflect the "live" state.
  let local-benefit ([resource-value] of target * resource-benefit-weight) +
                    ([quality] of target * quality-benefit-weight) +
                    (topic-match * topic-benefit-weight)

  set benefit-gain benefit-gain + local-benefit
  set motivation max (list 0.05
                 (min (list 1
                 (motivation + motivation-recovery * local-benefit - motivation-fatigue))))
  set my-last-page target
  set my-edit-count my-edit-count + 1
  set total-edits total-edits + 1

  ; --- bipartite edit log (one row per edit event) ---
  let pageid (word [pxcor] of target "_" [pycor] of target)
  let entry (list ticks who pageid specialty [topic-tag] of target [quality] of target)
  set edge-log lput entry edge-log

  ; v2 — count edits on active tasks (for task-edit-share / edits-on-tasks).
  ; Uses target-was-task?, captured before editing, so the edit that
  ; completes a task is counted too.
  if target-was-task? [
    set edits-on-tasks-count edits-on-tasks-count + 1
  ]

end

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; metrics
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; Recompute the global monitors each tick. ESR is event-level and
; cumulative; the alternative patch-level reporter is esr-value.
to update-metrics
  if total-edits > 0 [
    set ESR cross-author-edits / total-edits
  ]
  set mean-quality mean [quality] of patches
  set mean-resource-value mean [resource-value] of patches
  set mutualism-index (mean [benefit-gain] of contributors + mean-resource-value) / 2
  set coediting-density network-density
  set active-pages-share count patches with [edit-count > 0] / count patches
end

; Colour a patch according to its state.
;  - task patches: green when complete, red-tinted when incomplete with
;    high maintenance-need, orange otherwise.
;  - non-task patches: grey when never edited, otherwise shaded by
;    resource-value (sky < 0.4, blue 0.4-0.7, violet >= 0.7).
to recolor-patch
  if is-task? [
    if completeness >= task-completion-threshold [
      set pcolor green
    ]
    if completeness < task-completion-threshold [
      if maintenance-need > 0.6 [
        set pcolor red + 1
      ]
      if maintenance-need <= 0.6 [
        set pcolor orange
      ]
    ]
  ]

  if not is-task? [
    if edit-count = 0 [
      set pcolor gray + 2
    ]
    if edit-count > 0 and resource-value < 0.4 [
      set pcolor sky
    ]
    if edit-count > 0 and resource-value >= 0.4 and resource-value < 0.7 [
      set pcolor blue
    ]
    if edit-count > 0 and resource-value >= 0.7 [
      set pcolor violet
    ]
  ]
end

; Density of the co-editing network = 2 * links / (n * (n-1)).
to-report network-density
  let n count contributors
  if n < 2 [ report 0 ]
  report (2 * count coedits) / (n * (n - 1))
end

; v1 — Fixed task-completion-rate: completed tasks / initial tasks.
; A task counts as completed once its completeness reaches the threshold.
; Denominator is now the number of task-flagged patches at setup
; (initial-task-count), NOT all patches with task-complexity > 0.
to-report task-completion-rate
  if initial-task-count = 0 [ report 0 ]
  report tasks-completed / initial-task-count
end

; Mean shared-mental-model across all contributors.
to-report mean-shared-mental-model
  if not any? contributors [ report 0 ]
  report mean [shared-mental-model] of contributors
end

; Mean number of unique authors per edited patch.
to-report mean-authors-per-page
  if not any? patches with [edit-count > 0] [ report 0 ]
  report mean [length edit-authors] of patches with [edit-count > 0]
end

;;;

; Write the bipartite edit log to a CSV file with a header row.
to save-edge-log [filename]
  file-open filename
  file-print "tick,author_id,pageid,specialty,topic_tag,quality"
  foreach edge-log [ e1 ->
    file-print
      (word (item 0 e1) ","      ; tick
            (item 1 e1) ","      ; author_id
            (item 2 e1) ","      ; pageid
            (item 3 e1) ","      ; specialty
            (item 4 e1) ","      ; topic_tag
            (precision (item 5 e1) 4))  ; quality
  ]
  file-close
end

;;;
]]></code>
